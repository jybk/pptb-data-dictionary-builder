{
    "name": "@jybk/pptb-data-dictionary-builder",
    "version": "1.2.1",
    "displayName": "Data Dictionary Builder",
    "description": "Generate data dictionaries for Excel, CSV, Markdown and JSON from model-driven app forms and views, with fields in screen order, tabs and sections, and choice values.",
    "main": "index.html",
    "icon": "icons/data-dictionary-builder.svg",
    "license": "MIT",
    "author": "Jay",
    "contributors": [
        {
            "name": "Jay"
        }
    ],
    "keywords": [
        "powerplatform",
        "dataverse",
        "toolbox",
        "pptb",
        "data-dictionary",
        "documentation",
        "forms",
        "metadata"
    ],
    "configurations": {
        "repository": "https://github.com/jybk/pptb-data-dictionary-builder",
        "website": "https://github.com/jybk/pptb-data-dictionary-builder#readme",
        "readmeUrl": "https://raw.githubusercontent.com/jybk/pptb-data-dictionary-builder/main/README.md"
    },
    "features": {
        "minAPI": "1.2.7",
        "connections": 1
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jybk/pptb-data-dictionary-builder.git"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc --noEmit && node build.mjs",
        "watch": "node build.mjs --watch",
        "preview": "node build.mjs --preview",
        "test": "tsc -p tsconfig.test.json && node build.mjs --tests",
        "validate": "pptb-validate",
        "finalize-package": "npm shrinkwrap",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
    },
    "devDependencies": {
        "@pptb/types": "^1.2.8",
        "@types/node": "^22.20.5",
        "@xmldom/xmldom": "^0.9.8",
        "esbuild": "^0.25.12",
        "fflate": "^0.8.2",
        "typescript": "^5.6.0"
    },
    "files": [
        "dist",
        "npm-shrinkwrap.json"
    ],
    "homepage": "https://github.com/jybk/pptb-data-dictionary-builder#readme",
    "bugs": {
        "url": "https://github.com/jybk/pptb-data-dictionary-builder/issues"
    }
}
